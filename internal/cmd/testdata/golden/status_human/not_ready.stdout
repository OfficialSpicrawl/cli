base url:    http://SERVER
reachable:   yes
ready:       no (redis=unreachable)
cdp:         disabled (cloud browser /v1/browser is not available on this deployment)
key:         valid (from env)
workers:
  browser    2 ready of 3
  egress     1 ready of 1
  batch      0 ready of 2
repairs:
  - check: ready
    command: spicrawl status
    unattended_safe: true
    why: the API reports it is not ready (redis=unreachable): that is on the server side, wait a minute and re-run; nothing to change here
  - check: workers.batch
    command: spicrawl status
    unattended_safe: true
    why: no batch worker is ready (0 of 2): that is on the server side, wait a minute and re-run; if it persists, tell Spicrawl support
