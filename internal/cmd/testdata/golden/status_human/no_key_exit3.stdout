base url:    http://SERVER
reachable:   yes
ready:       yes
cdp:         enabled
key:         invalid: no API key configured
repairs:
  - check: key
    command: spicrawl login --api-key <YOUR_API_KEY>
    unattended_safe: false
    why: no API key is configured: create one at https://app.spicrawl.com/dashboard/keys and supply it
